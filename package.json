{
  "name": "walkwhile",
  "version": "0.1.0",
  "private": true,
  "description": "WalkWhile - Turn waiting time into walking opportunities",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run --workspaces --if-present build",
    "test": "npm run --workspaces --if-present test",
    "lint": "npm run --workspaces --if-present lint",
    "api": "npm run --workspace=apps/api dev",
    "render:build": "npm ci --include=dev --ignore-scripts -w @walkwhile/api -w @walkwhile/shared && npm run build -w @walkwhile/shared",
    "render:start": "npm run serve -w @walkwhile/api",
    "typecheck": "npm run --workspaces --if-present typecheck"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "react-native-svg": "15.8.0"
  }
}
