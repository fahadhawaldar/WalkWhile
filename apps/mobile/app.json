{
  "expo": {
    "name": "WalkWhile",
    "slug": "walkwhile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "walkwhile",
    "splash": {
      "backgroundColor": "#1B4332"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "WalkWhile uses your location to discover safe, circular walking routes from your exact starting point and monitor your return trip."
      },
      "bundleIdentifier": "com.fahadhdev.walkwhile"
    },
    "android": {
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.fahadhdev.walkwhile"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "WalkWhile uses your location to discover safe, circular walking routes from your exact starting point and monitor your return trip."
        }
      ]
    ]
  }
}
