# Server Configuration
PORT=3000
NODE_ENV=development

# Routing Provider Configuration
# 'osm' (default): WalkWhile's own planner on the pedestrian graph built by
#   scripts/prepareOsm.sh (falls back to 'mock' if the graph file is missing)
# 'openrouteservice': OpenRouteService API (needs OPENROUTESERVICE_API_KEY)
# 'mock': deterministic fake routes for offline testing
ROUTING_PROVIDER=osm

# Path to the pedestrian graph (defaults to <repo>/data/graphs/dubai.graph)
# GRAPH_PATH=

# OpenRouteService API Key (get free key at https://openrouteservice.org/dev/#/api-keys)
OPENROUTESERVICE_API_KEY=

# Base URL (defaults to official ORS API)
OPENROUTESERVICE_BASE_URL=https://api.openrouteservice.org
